# API origin only. Do not add /api; the client adds it to endpoint paths.
# Web browser on the same machine:
EXPO_PUBLIC_API_URL=http://localhost:8000

# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Physical device on the same LAN (replace with the development computer's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Production: HTTPS is mandatory outside development.
# EXPO_PUBLIC_API_URL=https://api.example.com
