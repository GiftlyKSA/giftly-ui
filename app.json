{
  "expo": {
    "name": "Giftly",
    "slug": "giftly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.giftly.app"
    },
    "android": {
      "package": "com.giftly.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Giftly uses your location to create and fulfill delivery requests."
        }
      ],
      "expo-localization"
    ],
    "scheme": "giftly"
  }
}
